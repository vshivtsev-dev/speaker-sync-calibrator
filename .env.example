# Copy to .env and fill in. Used by docker-compose.yml.

# Music Assistant, as reachable FROM this app.
SPEAKER_SYNC_MA_URL=http://192.168.1.10:8095
SPEAKER_SYNC_MA_TOKEN=

# This app, as reachable FROM MUSIC ASSISTANT — it fetches the test track from
# here. Not the address the browser uses. Use the Docker service name if MA
# shares the network, or the host's LAN address if it does not.
SPEAKER_SYNC_AUDIO_BASE_URL=http://speaker-sync:8080

# Protects the UI, the API and the socket. Without it, anyone who reaches the
# public URL can enumerate your speakers and start a calibration — loud test
# tones and rewritten sync_adjust.  Generate with: openssl rand -hex 24
SPEAKER_SYNC_ACCESS_TOKEN=

# Saved positions and the probed sign. In Docker this is /data on a volume.
SPEAKER_SYNC_STATE_DIR=
